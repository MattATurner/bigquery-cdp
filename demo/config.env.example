# =====================================================================
# Composable CDP demo — configuration template
#
# DO NOT put real values in this file. It is committed to version control.
# Run ./setup.sh to be prompted for your values; it writes config.env,
# which is git-ignored.
# =====================================================================

# --- Required: no default, setup.sh will insist -----------------------
CDP_PROJECT=""

# --- Location. Datasets, bucket and Vertex AI connection must all agree.
CDP_LOCATION="EU"

# --- Naming -----------------------------------------------------------
# Working dataset. Everything the pipeline reads and writes lives here.
CDP_DATASET_PREFIX="cdp"
# Ground truth lands in "<prefix>_truth" and the pipeline must never read it.

# GCS bucket backing the external tables and the object table.
# setup.sh defaults this to "<project>-cdp-demo" if left blank.
CDP_BUCKET=""

# BigQuery connection to Vertex AI. setup.sh offers to create it if absent.
CDP_CONNECTION="cdp-conn"

# --- Models -----------------------------------------------------------
# IMPORTANT: model IDs move fast. The Gemini 2.5 family is scheduled for
# deprecation from 16 Oct 2026; the 3.x family is current. Stage 05
# (preflight) makes one tiny call against each of these before the pipeline
# touches any data, so a wrong ID fails in seconds rather than at stage 20.
# Confirm availability in YOUR region — not every model is in every location.

# Embedding model. gemini-embedding-001 is used rather than text-embedding-005
# because it is current and has a published list price ($0.15 / 1M input
# tokens) that the cost model in stage 96 can be driven from.
CDP_EMBEDDING_ENDPOINT="gemini-embedding-001"

# Entity extraction from unstructured text (transcripts, ticket bodies).
# Kept separate from the adjudicator so the cheap, high-volume call and the
# expensive, low-volume one can be tuned independently. This one runs over
# every transcript and ticket, so it wants the cheapest capable tier.
CDP_EXTRACTION_MODEL="gemini-3.5-flash-lite"

# Pin the adjudicator model. An unpinned model makes merge decisions
# irreproducible, which defeats the audit story. This one runs only over the
# grey zone, so it can afford to be the better model.
CDP_ADJUDICATOR_MODEL="gemini-3.5-flash"
CDP_PROMPT_VERSION="adjudicator-v2"

# --- Corpus -----------------------------------------------------------
# 200k records / 80k people is the presentation scale.
# For fast debugging cycles use 20000 / 8000 — same seed, same hard cases,
# roughly a tenth of the cost and runtime.
CDP_PEOPLE="80000"
CDP_RECORDS="200000"
CDP_SEED="42"

# --- Cost guardrails --------------------------------------------------
# Hard cap on grey-zone pairs sent to the adjudicator, highest-scoring
# first. Hitting it is not fatal — it truncates the least interesting tail
# — but it is a signal that the thresholds, not the budget, need attention.
# Check v_candidate_funnel after the first run and tune from there.
# Scales roughly linearly with corpus size: 5000 was right for 20k records.
CDP_GREYZONE_CAP="50000"

# Candidates retrieved per probe record before tiering.
CDP_TOPK="25"

# Blocking keys with more members than this are discarded before pair
# generation, because a block of N members costs N^2/2 comparisons and a
# block that large is almost always a junk key (a default postcode, a
# placeholder phone number) rather than a real signal. The drop is recorded
# in block_stats so it is visible, not silent.
# This MUST scale with the corpus or a 10x run will either explode (too high)
# or silently discard real signal (too low). 500 was tuned at 20k records.
CDP_MAX_BLOCK_SIZE="2000"

# --- Matching thresholds ----------------------------------------------
# Tuned against the golden set. Precision is prioritised over recall:
# over-merging two real people is a privacy incident, under-merging is
# a data-quality ticket. Bias these conservative.
CDP_TAU_HI="0.92"
CDP_TAU_LO="0.72"
CDP_ACCEPT_CONFIDENCE="0.85"
CDP_STEWARD_CONFIDENCE="0.60"

# Score floors on the two tiering rails that divert to the adjudicator.
# Without them those rails promote every pair they touch into the grey zone
# regardless of score: on the first measured run that was 1,871,745 pairs,
# 1,097,960 of them at an average combined_score of 0.054.
#
# Both values were chosen from a sweep against ground truth, not picked.
# They trade 16 true pairs out of 18,774 (0.085%) for a 71% smaller grey
# zone, and the grey zone is what the adjudicator is billed for.
#
#   CDP_TAU_LOW_IDENTITY  one side carries almost no identity (a POS row is
#                         a surname, an initial and half a postcode).
#                         0.15 removes 1,032,804 junk pairs, loses 14 true.
#                         0.20 loses 72 more true to remove only 4,178 more.
#
#   CDP_TAU_SINGLE_SIGNAL one strong identifier agrees but nothing else does.
#                         0.40 removes 315,124 junk pairs, loses 2 true.
#                         0.55 loses 77 more. This rail carries real signal
#                         (4,114 true pairs) — do not tighten it casually.
#
# Re-sweep these if the corpus, the blocking keys or the scoring change.
CDP_TAU_LOW_IDENTITY="0.15"
CDP_TAU_SINGLE_SIGNAL="0.40"

# Minimum name similarity for a pair with NO exact name match and no strong
# identifier. Below this the pair is not a candidate at any score.
#
# The score floors above blend name, address, semantic and rule evidence, so a
# pair can clear them on address proximity alone while the names share nothing.
# Measured before this rule: 19% of the grey zone had neither forename nor
# surname matching, and only 0.45% of those were true matches -- the adjudicator
# was comparing "Luis Manwlo" with "Layla Hancock" because they shared a
# postcode.
#
# A surname change on marriage keeps a forename signal, so MARRIED_NAME is
# unaffected. Swept against ground truth: 0.70 removes 13,036 junk pairs for 66
# true ones; past that the trade turns sharply.
CDP_MIN_NAME_SIMILARITY="0.70"

# --- Cost model (stage 96) --------------------------------------------
# Stage 96 does NOT estimate cost from assumptions. It reads the token
# counts the models actually reported (usageMetadata on every AI.GENERATE
# call) and the bytes BigQuery actually billed, multiplies by the unit
# prices below, and extrapolates linearly to the target scale.
#
# >>> THESE ARE LIST PRICES CAPTURED ON 15 SEP 2026. THEY WILL GO STALE. <<<
# Confirm against cloud.google.com/vertex-ai/generative-ai/pricing and
# cloud.google.com/bigquery/pricing before putting a number in front of a
# customer. They are deliberately here, in config, so updating them is a
# one-line edit and every downstream number moves with them.
#
# PROVENANCE: the four model prices below were cross-checked against two
# independent price aggregators, NOT read off Google's own pricing page.
# Two sources agreeing is not a primary source. Re-confirm at source before
# any of these numbers reaches a customer.
#
# These must match the models pinned above. They currently price
# gemini-3.5-flash-lite (extraction) and gemini-3.5-flash (adjudicator).
# If you change a model pin, change its price in the same edit.
#
# NOTE: Gemini 3.7 Flash is newer than the pinned adjudicator and roughly
# half the cost ($0.75 / $3.75), but that is an introductory rate scheduled
# to double on 1 Jan 2027. If you switch, decide deliberately whether to
# model the intro rate or the post-January rate — a customer extrapolation
# built on intro pricing has a short shelf life.
#
# USD per 1M tokens.
CDP_PRICE_EMBED_INPUT="0.15"
CDP_PRICE_EXTRACT_INPUT="0.30"
CDP_PRICE_EXTRACT_OUTPUT="2.50"
CDP_PRICE_ADJUDICATE_INPUT="1.50"
CDP_PRICE_ADJUDICATE_OUTPUT="9.00"

# BigQuery compute. Set ONE of these to match how the customer actually buys.
# On-demand is USD per TiB scanned (US list). Slot-hour is Enterprise edition
# pay-as-you-go. The cost model reports both so the comparison is explicit.
CDP_PRICE_BQ_PER_TIB="6.25"
CDP_PRICE_BQ_SLOT_HOUR="0.06"

# Storage, USD per GiB-month, active logical.
CDP_PRICE_STORAGE_GIB_MONTH="0.02"

# Extrapolation target — the customer's real volume, not the demo's.
# Set these to the actual loyalty base and record estimate to make the
# cost model answer the question they will actually ask.
CDP_TARGET_RECORDS="15000000"
CDP_TARGET_PEOPLE="3000000"

# How often the full rebuild would run in production, per month.
# Drives the recurring-cost line. Incremental resolution is far cheaper than
# this implies — see the caveat in stage 96.
CDP_REBUILDS_PER_MONTH="4"
